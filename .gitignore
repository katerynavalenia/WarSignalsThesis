# ── Python ──────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
*.egg-info/
dist/
build/
.eggs/
*.egg

# ── Jupyter ─────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Environment / IDE ───────────────────
.env
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ── Configuration (local copies) ────────
config/paths.yaml
config/*.local.yaml

# ── Data (preserve structure, ignore content) ──
# Raw data: ignore file contents but keep directory structure
data/raw/**/*.csv
data/raw/**/*.xlsx
data/raw/**/*.xls
data/raw/**/*.parquet
data/raw/**/*.json
data/raw/**/*.jsonl
data/raw/**/*.txt
data/raw/**/*.zip
data/raw/**/*.gz
data/raw/**/*.tar

# Interim data
data/interim/**/*.csv
data/interim/**/*.parquet
data/interim/**/*.json

# Processed data
data/processed/**/*.csv
data/processed/**/*.parquet
# Exception: Phase 3 GDELT news outputs (tracked via LFS)
!data/processed/news/news_daily.csv
!data/processed/news/news_daily.parquet
!data/processed/news/gdelt_articles_dedup.parquet
!data/processed/news/gdelt_articles_classified.parquet
!data/processed/news/manual_precision_audit.csv

# External data
data/external/**/*.csv
data/external/**/*.parquet
data/external/**/*.xlsx

# ── Outputs (TRACK in git — these are reproducible from scripts/) ──
#   - ``outputs/figures/`` : PNG figures (figs 1–13)
#   - ``outputs/tables/``   : CSV tables (data dictionary, leakage audit,
#                             info-set cardinality, descriptive stats)
#   - ``outputs/model_objects/`` : fitted sklearn / statsmodels pickles
#   - ``outputs/logs/``     : training/eval logs
#
# All of these are regenerable from the scripts in ``scripts/`` but are
# tracked so that PRs and reviewers can inspect them without re-running
# the pipeline. Raw/interim/processed data remain on Google Drive
# (synced via rclone — see docs/data_sharing.md) and stay gitignored.

# ── Thesis build artifacts ──────────────

# ── Thesis build artifacts ──────────────
thesis/*.aux
thesis/*.bbl
thesis/*.blg
thesis/*.fdb_latexmk
thesis/*.fls
thesis/*.log
thesis/*.out
thesis/*.synctex.gz
thesis/*.toc

# ── Secrets ─────────────────────────────
*.pem
*.key
credentials.json
secrets.yaml

# Google OAuth credentials (do not commit)
client_secret_*.json

# ── Colab-simulated data (stored on Google Drive instead) ──
# 5.1 GB of enriched GKG parquets are too large for git.
# Data lives in Google Drive: WarSignalsThesis_Data/data/raw_enriched/
# See docs/data_sharing.md for setup.
data/news_colab_sim/**/*.parquet
data/news_colab_sim/**/*.csv
