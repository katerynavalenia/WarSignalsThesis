# ── Python ──────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
*.egg-info/
dist/
build/
.eggs/
*.egg

# ── Test / tooling caches ───────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── Jupyter ─────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Environment / IDE ───────────────────
.env
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ── Configuration (local copies) ────────
# Patterns use **/ so they match wherever a data or config tree sits.

**/config/paths.yaml
**/config/*.local.yaml

# ── Data (preserve structure, ignore content) ──
# Raw data: ignore file contents but keep directory structure
**/data/raw/**/*.csv
**/data/raw/**/*.xlsx
**/data/raw/**/*.xls
**/data/raw/**/*.parquet
**/data/raw/**/*.json
**/data/raw/**/*.jsonl
**/data/raw/**/*.txt
**/data/raw/**/*.zip
**/data/raw/**/*.gz
**/data/raw/**/*.tar

# Interim data
**/data/interim/**/*.csv
**/data/interim/**/*.parquet
**/data/interim/**/*.json

# ...except the v3 spine and perception indices. All under 500 KB, and the
# GDELT one cost 182 GB of BigQuery quota to build — regenerating it needs
# credentials and a day of the daily quota, so it is versioned rather than
# treated as scratch.
!data/interim/spine_full.parquet
!data/interim/gdelt_ecosystems_daily.parquet
!data/interim/perception_indices.parquet
# These two were omitted from the list above, so git treated them as scratch and
# they were destroyed when a worktree holding them was removed. They are the
# inputs to Gates 3 and 5 and cost roughly 400 GB of BigQuery to rebuild. Any
# new interim artefact that is expensive to regenerate belongs on this list
# BEFORE it is created, not after.
!data/interim/gdelt_threat_act_daily.parquet
!data/interim/gdelt_ecosystems_holdout.parquet
# spine_macro is cheap to rebuild -- GPR and FRED are free -- but it is the input
# to build_equity_spine.py, so without it the pipeline cannot be run from a fresh
# clone in the documented order. 60 KB to spare a reader that discovery.
!data/interim/spine_macro.parquet
# The classifier-sensitivity scan: five labellings of the corpus from one 380 GB
# query. Listed here BEFORE it was committed, which is the rule the paragraph
# above was written to enforce after the last two were lost.
!data/interim/gdelt_ecosystems_variants.parquet

# Processed data
**/data/processed/**/*.csv
**/data/processed/**/*.parquet
# Exception: Phase 3 GDELT news outputs (tracked via LFS) — v1 only






# External data
**/data/external/**/*.csv
**/data/external/**/*.parquet
**/data/external/**/*.xlsx

# ── Outputs (TRACK in git — these are reproducible from scripts/) ──
#   - ``outputs/figures/`` : PNG figures (figs 1–13)
#   - ``outputs/tables/``   : CSV tables (data dictionary, leakage audit,
#                             info-set cardinality, descriptive stats)
#   - ``outputs/model_objects/`` : fitted sklearn / statsmodels pickles
#   - ``outputs/logs/``     : training/eval logs
#
# All of these are regenerable from the scripts in ``scripts/`` but are
# tracked so that PRs and reviewers can inspect them without re-running
# the pipeline. Raw/interim/processed data remain on Google Drive
# (synced via rclone — see docs/data_sharing.md) and stay gitignored.

# ── Thesis build artifacts ──────────────
**/thesis/*.aux
**/thesis/*.bbl
**/thesis/*.blg
**/thesis/*.fdb_latexmk
**/thesis/*.fls
**/thesis/*.log
**/thesis/*.out
**/thesis/*.synctex.gz
**/thesis/*.toc

# ── Secrets ─────────────────────────────
*.pem
*.key
credentials.json
secrets.yaml

# Google OAuth credentials (do not commit)
client_secret_*.json

# Google service-account keys download with unpredictable names such as
# <project>-<keyid>.json, which none of the patterns above catch. Keys belong
# outside the repo entirely (~/.config/gcp/); this is only a backstop against
# one landing here and being swept up by `git add -A`.
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*.json
*service-account*.json
*service_account*.json
gcp-*.json

# ── Colab-simulated data (stored on Google Drive instead) ──
# 5.1 GB of enriched GKG parquets are too large for git.
# Data lives in Google Drive: WarSignalsThesis_Data/data/raw_enriched/
# See docs/v1/data_sharing.md for setup (v1 only).
**/data/news_colab_sim/**/*.parquet
**/data/news_colab_sim/**/*.csv

# ── Claude Code ─────────────────────────
# Track the shared project config (.claude/settings.json, .claude/cloud_setup.sh);
# ignore per-machine state. See docs/cloud_sessions.md.
.claude/*
!.claude/settings.json
!.claude/cloud_setup.sh
.claude/settings.local.json
