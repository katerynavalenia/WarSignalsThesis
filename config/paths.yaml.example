# Paths configuration template
# Copy this file to config/paths.yaml and fill in local paths.
# config/paths.yaml is gitignored and should never contain secrets.

# Root directory of the project (absolute or relative to repo root)
project_root: "."

# Data directories
data:
  raw: "data/raw"
  interim: "data/interim"
  processed: "data/processed"
  external: "data/external"

# Raw data subdirectories
raw_subdirs:
  bloomberg: "data/raw/bloomberg"
  attacks: "data/raw/attacks"
  air_alerts: "data/raw/air_alerts"
  gdelt: "data/raw/gdelt"
  controls: "data/raw/controls"

# Output directories
outputs:
  figures: "outputs/figures"
  tables: "outputs/tables"
  model_objects: "outputs/model_objects"
  logs: "outputs/logs"

# Processed file names
processed_files:
  daily_master: "data/processed/daily_master.parquet"
  model_matrix: "data/processed/model_matrix.parquet"
  data_dictionary: "data/processed/data_dictionary.csv"
